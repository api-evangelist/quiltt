              "raw": "{\n  \"userId\": \"<string>\",\n  \"uuid\": \"<string>\",\n  \"email\": \"<email>\",\n  \"metadata\": {\n    \"key_0\": 2925.0744901305693,\n    \"key_1\": true\n  }\n}",
